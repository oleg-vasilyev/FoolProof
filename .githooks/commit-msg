#!/bin/sh
#
# Keep DEVELOPMENT-FLOW.md and the logbook honest in the three ways a machine can
# check.
#
# It is the owner's map of how this product gets built. The retrospective may
# redraw it without asking — stalling a finished phase on a decision already
# delegated is the worse failure — but a silent redraw leaves him to meet the
# change as a diff months later with the reasoning gone. A chat message does
# not fix that: it scrolls away. The commit message is where the reason
# survives next to the change, so that is what is gated.
#
# The second gate is drift. A drawing that changes while nothing it draws does
# has stopped describing the project and started describing an intention. So a
# commit that edits the *process* — an arrow, a stage, a branch — must also
# carry the thing that process lives in: a skill, the rules, the commands, the
# hooks, the CI. Editing the prose or the colours around the drawing is not
# that, and is not asked for either.
#
# The third gate is about the logbook rather than the drawing. A phase that
# closes with a 'Retro:' or 'Gates:' paragraph has been through its retrospective,
# and the retrospective writes logbook/phases/<date>-<slug>.md before the commit —
# three of twelve phases in one week carried the paragraph and staged no log, and
# the checkup that counts the logs had nothing to count. The log is new by
# definition: one file per phase, never an edit to an older one.
#
# Installed by npm install: prepare points core.hooksPath at this folder.

message_file="$1"

staged=$(git diff --cached --name-only)

if grep -qE '^(Retro|Gates):' "$message_file"; then
  new_logs=$(git diff --cached --name-only --diff-filter=A -- logbook/phases/)

  if [ -z "$new_logs" ]; then
    echo "commit-msg: this message closes a phase and no phase log is staged with it."
    echo
    echo "A 'Retro:' or 'Gates:' paragraph says the retrospective ran, and the"
    echo "retrospective writes the log before the commit — a new file under"
    echo "logbook/phases/, named <date>-<slug>.md after this commit's title, in the"
    echo "format logbook/README.md gives. Stage it with the code it describes; a phase"
    echo "whose log is written later is one the checkup counts as never logged."
    exit 1
  fi
fi

# The fourth gate is the paragraph itself. check:* writes it under a stamp naming
# the battery, the HEAD it ran at and the time; a paragraph from an older HEAD, or
# from a different battery than the message claims, once reached a commit reading as
# fresh. The stamp's HEAD must be this commit's parent and its battery the one the
# 'Gates:' line names. An amend is refused by the same rule — HEAD is then the
# commit itself, not its parent — and that is meant: a phase-final commit is not
# amended here, and a paragraph that passed once must not pass a second commit.
# The stamp's grammar is written by paragraphFileOf in scripts/gates/gate-summary.ts
# and read by the two cuts below; a probe in the phase that wrote them pinned both.
if grep -qE '^Gates: check:' "$message_file"; then
  paragraph_file="reports/gates/gates-paragraph.txt"
  stamp=$(head -n 1 "$paragraph_file" 2>/dev/null)
  stamped_battery=$(echo "$stamp" | cut -d' ' -f1)
  stamped_head=$(echo "$stamp" | cut -d' ' -f3)
  claimed_battery=$(grep -m1 -E '^Gates: check:' "$message_file" | cut -d' ' -f2)
  head_now=$(git rev-parse HEAD)

  if [ "$stamped_head" != "$head_now" ] || [ "$stamped_battery" != "$claimed_battery" ]; then
    echo "commit-msg: the Gates paragraph on disk is not this commit's."
    echo
    echo "$paragraph_file is stamped '$stamp'; this commit's parent is $head_now and the"
    echo "message claims $claimed_battery. A paragraph run at another HEAD or by another"
    echo "battery reads as fresh and is not. Re-run the battery the message names —"
    echo "npm run $claimed_battery — and paste its Gates line."
    exit 1
  fi
fi

if ! echo "$staged" | grep -q '^DEVELOPMENT-FLOW\.md$'; then
  exit 0
fi

if ! grep -q '^Flow:' "$message_file"; then
  echo "commit-msg: this commit redraws DEVELOPMENT-FLOW.md and the message does not say why."
  echo
  echo "Add a paragraph starting with 'Flow:' that names what moved and the counts"
  echo "that forced it — a redraw argued from an impression is one that should not"
  echo "have been made. A wording-only edit says so in the same line."
  echo
  echo "  Flow: stage 2 loses the subagents — three phases running, delegation cost"
  echo "  more than it returned (493k tokens, two scopes redone by hand)."
  exit 1
fi

process_changed=$(git diff --cached -U0 -- DEVELOPMENT-FLOW.md |
  grep -E '^[+-]' |
  grep -cE '(->>|--\)|note over|^[+-][[:space:]]*(opt|alt|else|loop|par|and|rect|end)([[:space:]]|$))')

if [ "$process_changed" -eq 0 ]; then
  exit 0
fi

# scripts/ is on this list because a gate is a backer too: the errand-lane check in
# check-docs.ts is the only thing standing behind the drawing's agent lanes.
if echo "$staged" | grep -qE '^(\.claude/|CLAUDE\.md$|package\.json$|\.githooks/|\.github/|scripts/)'; then
  exit 0
fi

echo "commit-msg: the drawn process changed and nothing it draws did."
echo
echo "DEVELOPMENT-FLOW.md is the map, not the authority: a step only means something"
echo "because a skill, a rule, a command or a hook stands behind it. A commit that"
echo "moves an arrow on its own leaves the drawing describing an intention rather"
echo "than this project."
echo
echo "Carry the change it reflects in the same commit — a file under .claude/,"
echo "CLAUDE.md, package.json, .githooks/ or .github/. If the drawing was simply"
echo "wrong about what the project already does, the fix belongs in the file that"
echo "was right, not only here."

exit 1
