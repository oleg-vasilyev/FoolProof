# Copy to .env and fill in. Every key the app reads is listed here.

# From @BotFather.
BOT_TOKEN=

# Where the SQLite file lives, relative to the project root.
DB_PATH=data/foolproof.db

# debug | info | warn | error
LOG_LEVEL=info

# Webhook mode only (npm start). Long polling (npm run dev) ignores these.
# WEBHOOK_URL is the public https address Telegram posts updates to.
WEBHOOK_URL=
WEBHOOK_PORT=8080
# Any random string; Telegram echoes it back so foreign posts can be rejected.
WEBHOOK_SECRET=
