# The template for both env files. Every key the app reads is listed here.
#
#   cp .env.example .env             -> npm start
#   cp .env.example .env.production  -> npm run start:prod
#
# Each file is the WHOLE configuration for its run: there is no fallback from one
# to the other, so a key missing from .env.production is missing, not inherited.
# That is deliberate — inheritance is how a production run quietly ends up on the
# dev database.

# From @BotFather. One bot can serve both files as long as only one process runs at
# a time: two pollers on one token make Telegram split the updates between them.
BOT_TOKEN=

# Where the SQLite file lives, relative to the project root. This is the one line
# that must differ between the two files:
#   dev   data/foolproof.dev.db
#   prod  data/foolproof.db
DB_PATH=data/foolproof.dev.db

# debug | info | warn | error
LOG_LEVEL=info
