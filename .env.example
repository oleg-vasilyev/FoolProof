# The template for .env, which is the server's configuration kept where you can
# edit it. Every key the app reads is listed here.
#
#   cp .env.example .env        fill it in
#   deploy/configure-server.sh  sends it, as .env.production, and restarts the bot
#
# Nothing local runs from it. One token serves one process, that process is the bot
# on the server, and a second poller here would split the updates with it — so there
# is no npm script that loads an env file at all. Playing with the bot locally is
# `npm run play`, which needs no token.
#
# DB_PATH is the one key the script rewrites on the way, because the database has to
# live outside the clone a deploy checks out. Everything else arrives as written.
#
# The file that lands there is the WHOLE configuration for that run: nothing is
# inherited from anywhere, so a key missing here is missing there.
#
# A key left empty counts as missing. A half-filled file is the normal state of a
# fresh copy of this one, so `KEY=` has to mean what leaving the line out means — an
# optional key falls back to its default, a required one refuses to start. It read
# as "set to nothing" once, and an empty OPERATOR_TG_ID locked everybody out of
# /status instead of letting everybody in.

# From @BotFather.
BOT_TOKEN=

# Where the SQLite file lives. A relative path is resolved from the project root; an
# absolute one is taken as it is. configure-server.sh replaces this line with the
# server's own absolute path on the way, so what stands here only matters if you
# ever run the supervisor by hand — which wants a local file, not the server's.
DB_PATH=data/foolproof.dev.db

# debug | info | warn | error
LOG_LEVEL=info

# Optional. The Telegram user id allowed to run /status, the hidden command that
# reports which database is in use, how long the bot has been up and what has gone
# wrong. Leave it empty and anyone in the chat may run it — the report holds no
# secrets, but it is noise for everyone else. Ask @userinfobot for your id.
OPERATOR_TG_ID=

# Set by the supervisor on the process it starts, so /status can say that the bot
# was restarted and how the previous run ended. Never set these by hand.
#   BOT_START_ATTEMPT
#   BOT_PREVIOUS_EXIT

# Set by `npm run e2e` and `npm run play` on the bot they start, and by nothing
# else. It replaces api.telegram.org with the fake Telegram in e2e/, which is why
# those need no token and no network. A run pointed anywhere but Telegram warns on
# startup — leave this out of the file.
#   BOT_API_ROOT
