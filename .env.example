# The template for both env files. Every key the app reads is listed here.
#
#   cp .env.example .env             -> npm start
#   cp .env.example .env.production  -> npm run start:prod
#
# Each file is the WHOLE configuration for its run: there is no fallback from one
# to the other, so a key missing from .env.production is missing, not inherited.
# That is deliberate — inheritance is how a production run quietly ends up on the
# dev database.

# From @BotFather. One bot can serve both files as long as only one process runs at
# a time: two pollers on one token make Telegram split the updates between them.
BOT_TOKEN=

# Where the SQLite file lives, relative to the project root. This is the one line
# that must differ between the two files:
#   dev   data/foolproof.dev.db
#   prod  data/foolproof.db
DB_PATH=data/foolproof.dev.db

# debug | info | warn | error
LOG_LEVEL=info

# Optional. The Telegram user id allowed to run /status, the hidden command that
# reports which database is in use, how long the bot has been up and what has gone
# wrong. Leave it empty and anyone in the chat may run it — the report holds no
# secrets, but it is noise for everyone else. Ask @userinfobot for your id.
OPERATOR_TG_ID=

# Set by the supervisor on the process it starts, so /status can say that the bot
# was restarted and how the previous run ended. Never set these by hand.
#   BOT_START_ATTEMPT
#   BOT_PREVIOUS_EXIT

# Set by `npm run e2e` on the bot it starts, and by nothing else. It replaces
# api.telegram.org with the fake Telegram in scripts/e2e/, so a scenario needs no
# token and no network. A run pointed anywhere but Telegram warns on startup —
# leave this out of both env files.
#   BOT_API_ROOT
