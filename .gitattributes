# A systemd unit is read by a Linux host, so it is stored and checked out with LF
# whatever the machine that edited it does. Nothing here has yet been broken by a
# CRLF checkout — this is the guard that keeps it that way, since the file reaches
# a server without anything in between that would notice.
*.service text eol=lf
*.timer text eol=lf
*.sh text eol=lf
# Git hooks run under sh too, and have no extension to be caught by the rule above.
.githooks/* text eol=lf
# Not read by a host, but copied to .env and sent to one — a CRLF checkout would
# put a carriage return on the end of every value, including the token.
.env.example text eol=lf
