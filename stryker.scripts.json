{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["html", "json", "clear-text"],
  "clearTextReporter": { "skipFull": true },
  "jsonReporter": {
    "fileName": "reports/mutation-scripts/mutation.json"
  },
  "tempDirName": "reports/.stryker-scripts-tmp",
  "ignorePatterns": ["/reports"],
  "htmlReporter": {
    "fileName": "reports/mutation-scripts/index.html"
  },
  "coverageAnalysis": "perTest",
  "concurrency": "75%",
  "timeoutMS": 20000,
  "mutate": [
    "scripts/docs-check/**/*.ts",
    "scripts/hooks/**/*.ts",
    "scripts/run-battery.ts",
    "scripts/gate-list.ts",
    "scripts/gate-paths.ts",
    "scripts/gate-numbers.ts",
    "scripts/gate-verdict.ts",
    "scripts/gate-runner.ts",
    "scripts/gate-summary.ts",
    "scripts/mutate-changed.ts",
    "scripts/mutation-families.ts",
    "scripts/tool-verdict.ts",
    "!scripts/**/*.spec.ts",
    "!scripts/**/*.stub.ts",
    "!scripts/docs-check/source-files.ts",
    "!scripts/docs-check/document-files.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  }
}
