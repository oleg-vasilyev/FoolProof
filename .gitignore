# secrets — .env.example is the only one that may be committed.
# `.env` alone would NOT have matched .env.production, so the pattern is a glob.
.env
.env.*
!.env.example
secrets/

# the SQLite database and its WAL sidecars
data/

# machine-local Claude Code settings (paths + personal permission grants)
# .claude/settings.json IS shared — it carries the project hooks
.claude/settings.local.json

# everything a check writes: coverage/, mutation/, .stryker-tmp/
reports/

# build / deps / noise
node_modules/
dist/
*.log
.DS_Store
Thumbs.db
