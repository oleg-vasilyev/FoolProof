{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/refuse-a-shell-payload-that-breaks.mjs",
            "timeout": 10,
            "statusMessage": "Checking the command survives the shell…"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/refuse-a-gate-run-by-hand.mjs",
            "timeout": 10,
            "statusMessage": "Checking the gate goes through the runner…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/lint-changed.mjs",
            "timeout": 60,
            "statusMessage": "Linting the changed file…"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/flow-edit-owes-a-reason.mjs",
            "timeout": 10,
            "statusMessage": "Checking what was edited…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/refuse-a-turn-ending-on-a-promise.mjs",
            "timeout": 15,
            "statusMessage": "Checking the turn actually finished…"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "1"
  }
}
