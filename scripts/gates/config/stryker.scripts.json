{
  "$schema": "../../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": { "configFile": "scripts/gates/config/vitest.config.ts" },
  "reporters": ["html", "json", "clear-text"],
  "clearTextReporter": { "skipFull": true },
  "jsonReporter": {
    "fileName": "reports/mutation-scripts/mutation.json"
  },
  "tempDirName": "reports/.stryker-scripts-tmp",
  "ignorePatterns": ["/reports"],
  "htmlReporter": {
    "fileName": "reports/mutation-scripts/index.html"
  },
  "coverageAnalysis": "perTest",
  "concurrency": "75%",
  "timeoutMS": 20000,
  "mutate": [
    "scripts/docs-check/**/*.ts",
    "scripts/hooks/**/*.ts",
    "scripts/gates/**/*.ts",
    "scripts/tools/tool-verdict.ts",
    "scripts/benchmark/**/*.ts",
    "!scripts/gates/config/**",
    "!scripts/gates/e2e-changed.ts",
    "!scripts/**/*.spec.ts",
    "!scripts/**/*.stub.ts",
    "!scripts/docs-check/check-docs.ts",
    "!scripts/docs-check/source-files.ts",
    "!scripts/docs-check/document-files.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  }
}
