{
  "name": "foolproof",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/bot.ts",
    "check": "npm run lint && npm run typecheck",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "grammy": "^1.45.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript": "^6.0.3"
  }
}
