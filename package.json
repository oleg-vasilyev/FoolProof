{
  "name": "foolproof",
  "version": "1.20.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "imports": {
    "#app/*": "./src/*",
    "#shared/*": "./src/shared/*",
    "#live-game/*": "./src/features/live-game/*",
    "#merge-names/*": "./src/features/merge-names/*",
    "#replace-names/*": "./src/features/replace-names/*",
    "#scoresheet/*": "./src/features/scoresheet/*",
    "#diagnostics/*": "./src/features/diagnostics/*",
    "#language/*": "./src/features/language/*"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "start": "node e2e/play.ts",
    "start:prod": "node --env-file=.env.production src/supervisor.ts",
    "check:quick": "node scripts/gates/run-battery.ts check:quick",
    "check:push": "node scripts/gates/run-battery.ts check:push",
    "check:phase": "node scripts/gates/run-battery.ts check:phase",
    "check:release": "node scripts/gates/run-battery.ts check:release",
    "e2e:watch": "node e2e/watch-live.ts"
  },
  "overrides": {
    "qs": "^6.16.0",
    "fast-uri": "^3.1.6"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "grammy": "^1.45.1"
  },
  "devDependencies": {
    "@jsquash/webp": "^1.5.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "mutation-testing-metrics": "3.7.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
