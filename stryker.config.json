{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": [
    "html",
    "json",
    "clear-text",
    "progress"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "tempDirName": "reports/.stryker-tmp",
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 20000,
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.stub.ts",
    "!src/**/sqlite-connection.ts",
    "!src/**/repository-instance.ts",
    "!src/**/repository-contract.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": 85,
    "break": 85
  }
}
