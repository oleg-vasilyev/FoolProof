{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["html", "clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 20000,
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.stub.ts",
    "!src/bot.ts",
    "!src/shared/db.ts",
    "!src/shared/repository/index.ts",
    "!src/shared/repository/types.ts"
  ],
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": 60
  }
}
